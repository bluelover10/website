# SiteForge server env example — copy to .env
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/siteforge
# REQUIRED. Generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to boot in production without a >=32-char secret.
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Set to 1 ONLY when the API runs behind a trusted reverse proxy (nginx etc.)
TRUST_PROXY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads
# Platform admin (seeded at boot; MUST be overridden with a strong value in production)
ADMIN_EMAIL=admin@siteforge.app
ADMIN_PASSWORD=
ADMIN_NAME=SiteForge Admin
